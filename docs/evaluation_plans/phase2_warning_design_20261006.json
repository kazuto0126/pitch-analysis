  "new_diagnostic_thresholds": null,
  "phase2_acceptance": "in_progress",
  "purpose": "Design generic warning-only evidence and exact-frame regression evaluation.",
  "predictor_allowed_inputs": [
    "prepared MP4",
    "metadata and handedness",
    "saved raw landmarks",
    "selection trace",
    "saved pose/tracking reliability reports with original observed-adjacent jump endpoints",
    "prior image evidence"
  ],
  "predictor_forbidden_inputs": [
    "manual X/Y",
    "canonical or peer ground truth",
    "human event/failure frames",
    "pitch-specific frame rules"
  ],
  "evaluation_only_references": {
    "canonical_contract": "ground-truth-v1",
    "coordinate_contract": "manual-keypoints-v1",
    "comparison": {
      "path": "analysis_results/phase2_gt_comparison_20261004_01/ground_truth_comparison_verified.json",
      "sha256": "02d082f4772f062ae5bbc3e9747274bae85b5d97e51564d1b75012f70b458181"
    },
    "manual_reference": {
      "path": "annotations/manual_keypoints/HSU_TSAI_RETURN_20261005_42/pitch_003/manual_keypoints.json",
      "sha256": "a970354b14f728d38af97336d6872900625c956e7a105f75ab9cdcff0aa77735"
    }
  },
  "planned_warning_scopes": [
    "major_pose_alignment",
    "joint_alignment",
    "selection_break",
    "image_evidence_insufficient"
  ],
  "planned_decision_states": [
    "warning",
    "no_warning",
    "insufficient_evidence"
  ],
  "required_warning_fields": [
    "pitch_id",
    "frame_index",
    "timestamp_ms",
    "scope",
    "joint_if_applicable",
    "decision",
    "reason",
    "evidence_validity",
    "raw_evidence_values",
    "policy_version",
    "source_artifact_hashes",
    "marked_interval_if_any",
    "emission_frame_if_online"
  ],
  "policy": {
    "raw_and_processed_predictions": "immutable; warning sidecar does not correct or train coordinates",
    "existing_selector_gate_interpolation_smoothing": "unchanged",
    "absence_of_warning": "not evidence of correct coordinates or identity",
    "human_uncertain_not_observable": "exclude from the matching target denominator; never convert to negative",
    "prediction_insufficient_evidence": "do not remove from full eligible-GT denominator; report abstention by human class",
    "predicted_interval": "explicit output interval only; exact-frame primary, no added tolerance",
    "joint_warnings": "score against matching joint labels; do not automatically classify whole-body failure",
    "identity_switch": "zero positive examples; recall null; pose misalignment does not confirm identity switch",
    "coordinate_error": "visible manual XY only; per-joint distance, missing count, coverage and fixed-subset retention",
    "event_accuracy": "unmeasured; no automatic event predictions or invented exact events",
    "parameter_selection": "development set already examined; not independent validation; numeric diagnostic bounds unset"
  },
  "candidate_evidence": [
    {
      "name": "independent_image_motion",
      "implementation": "proposed only",
      "idea": "Image feature continuity around automatically seeded torso anchors; forward/backward consistency and evidence coverage.",
      "limits": "Seed is a hypothesis, not identity truth; rotation, blur, occlusion or background flow may invalidate evidence."
    },
    {
      "name": "local_arm_alignment",
      "implementation": "proposed only",
      "idea": "Existing observed-adjacent current-frame jump endpoints from saved pose reliability, raw projected segment changes and valid image-motion disagreement.",
      "limits": "Fast real motion, rotation and foreshortening are not automatic errors; occluded position remains unknown."
    }
  ],
  "required_metrics": [
    "per-pitch exact-frame TP/FN/FP/TN and excluded counts",
    "target-specific precision/recall/FPR",
    "warning total frames and interval any-hit",
    "first-warning latency and interval boundary error where defined",
    "prediction abstention counts by human label and decision coverage",
    "visible raw-coordinate per-joint error on fixed reference set",
    "all warning reasons and source hashes; no weighted composite score"
  ],
