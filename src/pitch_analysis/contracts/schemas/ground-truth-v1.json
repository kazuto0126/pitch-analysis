{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ground-truth-v1",
  "title": "Manual single-pitch ground truth",
  "description": "Human labels kept separate from raw model predictions. Frame indices are zero based and inclusive.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "annotation_status", "source_video", "provenance", "labels", "notes"],
  "properties": {
    "schema_version": {"const": "ground-truth-v1"},
    "annotation_status": {"enum": ["unreviewed", "in_progress", "reviewed"]},
    "source_video": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pitch_id", "filename", "sha256", "total_frames", "frame_index_base"],
      "properties": {
        "pitch_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_]{0,79}$"},
        "filename": {"type": "string", "pattern": "^[^/\\\\:]+\\.[mM][pP]4$"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "total_frames": {"type": "integer", "minimum": 2},
        "frame_index_base": {"const": 0}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewer", "reviewed_at_utc", "method", "guidelines_version"],
      "properties": {
        "reviewer": {"type": ["string", "null"], "minLength": 1},
        "reviewed_at_utc": {"type": ["string", "null"], "format": "date-time", "pattern": "(Z|\\+00:00)$"},
        "method": {"const": "manual_video_review"},
        "guidelines_version": {"const": "ground-truth-guidelines-v1"}
      }
    },
    "labels": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pitcher_correctly_selected", "identity_switch_intervals", "major_pose_failure_intervals", "throwing_elbow_reliability", "lead_knee_reliability", "events"],
      "properties": {
        "pitcher_correctly_selected": {"type": ["boolean", "null"]},
        "identity_switch_intervals": {"oneOf": [{"type": "null"}, {"type": "array", "items": {"$ref": "#/$defs/frame_interval"}}]},
        "major_pose_failure_intervals": {"oneOf": [{"type": "null"}, {"type": "array", "items": {"$ref": "#/$defs/frame_interval"}}]},
        "throwing_elbow_reliability": {"oneOf": [{"type": "null"}, {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/reliability_interval"}}]},
        "lead_knee_reliability": {"oneOf": [{"type": "null"}, {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/reliability_interval"}}]},
        "events": {
          "type": "object",
          "additionalProperties": false,
          "required": ["preparation_start", "leg_lift", "foot_plant", "approximate_release", "follow_through_end"],
          "properties": {
            "preparation_start": {"$ref": "#/$defs/nullable_event"},
            "leg_lift": {"$ref": "#/$defs/nullable_event"},
            "foot_plant": {"$ref": "#/$defs/nullable_event"},
            "approximate_release": {"$ref": "#/$defs/nullable_event"},
            "follow_through_end": {"$ref": "#/$defs/nullable_event"}
          }
        }
      }
    },
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "frame_interval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_frame", "end_frame", "reason"],
      "properties": {
        "start_frame": {"type": "integer", "minimum": 0},
        "end_frame": {"type": "integer", "minimum": 0},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "reliability_interval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_frame", "end_frame", "status", "reason"],
      "properties": {
        "start_frame": {"type": "integer", "minimum": 0},
        "end_frame": {"type": "integer", "minimum": 0},
        "status": {"enum": ["reliable", "unreliable", "uncertain"]},
        "reason": {"type": "string"}
      }
    },
    "nullable_event": {
      "oneOf": [{"type": "null"}, {"$ref": "#/$defs/event"}]
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "frame_index", "note"],
      "properties": {
        "status": {"enum": ["annotated", "not_visible", "uncertain"]},
        "frame_index": {"type": ["integer", "null"], "minimum": 0},
        "note": {"type": "string"}
      },
      "if": {"properties": {"status": {"const": "annotated"}}},
      "then": {"properties": {"frame_index": {"type": "integer"}}},
      "else": {"properties": {"frame_index": {"type": "null"}}}
    }
  }
}
